# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Create a GA4 property at https://analytics.google.com and paste the ID here.
# GA4 only loads in production builds when this value is set.
# Copy this file to .env.local for local development.
NEXT_PUBLIC_GA_ID=

# Resend API key for the contact form (server-only — never exposed to the client).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Email address that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=

# Verified sender address. Use onboarding@resend.dev until you verify a domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev
